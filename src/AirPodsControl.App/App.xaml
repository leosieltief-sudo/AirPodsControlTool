<Application x:Class="AirPodsControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AirPodsControl.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <Color x:Key="PanelColor">#F20D121C</Color>
            <Color x:Key="CardColor">#FF1C2331</Color>
            <Color x:Key="CardHoverColor">#FF242C3D</Color>
            <Color x:Key="AccentColor">#FF7EE0A0</Color>
            <Color x:Key="ActiveColor">#FF2C4C7E</Color>
            <Color x:Key="ActiveGlowColor">#FF6FA8FF</Color>
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFFFC857" />
            <SolidColorBrush x:Key="BadBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFE9EEF6" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF8E9AAF" />
            <SolidColorBrush x:Key="LabelBrush" Color="#FF9FD8B4" />
            <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource ActiveColor}" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Flat icon button for the title bar -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#14FFFFFF" CornerRadius="6" Padding="9,4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Listening-mode button. IsActive = confirmed by the AirPods; IsPending = command in flight. -->
            <Style TargetType="c:ModeButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="84" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:ModeButton">
                            <Grid>
                                <Border x:Name="glow" CornerRadius="14" Background="{StaticResource ActiveBrush}" Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource ActiveGlowColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="bd" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="#14FFFFFF" BorderThickness="1" />
                                <Border x:Name="activeFill" CornerRadius="14" Opacity="0" BorderThickness="1" BorderBrush="#996FA8FF">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF35609E" Offset="0" />
                                            <GradientStop Color="#FF264574" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="pendingRing" CornerRadius="14" BorderThickness="1.5" BorderBrush="{StaticResource AccentBrush}" Opacity="0" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="icon" Data="{TemplateBinding Glyph}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                                          Width="22" Height="22" Opacity="0.85" HorizontalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Margin="0,9,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsActive" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="activeFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                                <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="activeFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPending" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="pendingSb">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pendingRing" Storyboard.TargetProperty="Opacity" From="0.2" To="1"
                                                                 Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="pendingSb" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
