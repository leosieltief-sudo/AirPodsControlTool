<Window x:Class="AirPodsControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AirPodsControl.App.Controls"
        xmlns:p="clr-namespace:AirPodsControl.Core.Protocol;assembly=AirPodsControl.Core"
        Title="AirPods Control" Width="448" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Geometry x:Key="GlyphAnc">M0,9 h2.4 v6 h-2.4z M4.4,5 h2.4 v14 h-2.4z M8.8,1 h2.4 v22 h-2.4z M13.2,5 h2.4 v14 h-2.4z M17.6,8 h2.4 v8 h-2.4z M22,10 h2 v4 h-2z</Geometry>
        <Geometry x:Key="GlyphOff">F1 M12,0 A12,12 0 1 1 11.99,0 Z M12,2.6 A9.4,9.4 0 1 0 12.01,2.6 Z M4.3,6.1 L6.1,4.3 L19.7,17.9 L17.9,19.7 Z</Geometry>
        <Geometry x:Key="GlyphTransparency">F1 M12,0 A12,12 0 1 1 11.99,0 Z M12,2.4 A9.6,9.6 0 1 0 12.01,2.4 Z M12,5.6 A6.4,6.4 0 1 1 11.99,5.6 Z M12,8 A4,4 0 1 0 12.01,8 Z M12,10.4 A1.6,1.6 0 1 1 11.99,10.4 Z</Geometry>
        <Geometry x:Key="GlyphAdaptive">F1 M12,0 A12,12 0 1 1 11.99,0 Z M12,2.4 A9.6,9.6 0 1 0 12.01,2.4 Z M12,4.4 A7.6,7.6 0 0 1 12,19.6 Z</Geometry>
    </Window.Resources>

    <Grid Margin="16" x:Name="shell" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="shellSlide" />
        </Grid.RenderTransform>
        <Border CornerRadius="22" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="18,14,18,18">
            <!-- Header -->
            <Grid x:Name="header" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#FF6FA8FF" VerticalAlignment="Center" Margin="2,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ModelName}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="statusPill" CornerRadius="9" Padding="8,3" Margin="0,0,6,0" Background="#1F7EE0A0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="statusDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="statusText" Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Hide to tray" Click="Hide_Click" />
                </StackPanel>
            </Grid>

            <!-- Visualisation -->
            <Border CornerRadius="16" Margin="0,14,0,0" Height="210" BorderBrush="#10FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
                        <GradientStop Color="#FF232A38" Offset="0" />
                        <GradientStop Color="#FF141924" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Grid>
                    <c:AirPodsVisual x:Name="visual" Margin="10,12,10,8" Shape="{Binding Shape}" IsConnected="{Binding IsConnected}" Mode="{Binding ActiveMode}" />
                    <TextBlock Text="No AirPods paired" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevice}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Text="{Binding ModeCaption}" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource LabelBrush}" />

            <!-- Battery -->
            <UniformGrid Columns="3" Margin="-4,12,-4,0">
                <c:BatteryCard DataContext="{Binding Left}" Margin="4,0" />
                <c:BatteryCard DataContext="{Binding Right}" Margin="4,0" />
                <c:BatteryCard DataContext="{Binding Case}" Margin="4,0" />
            </UniformGrid>
            <!-- Battery refresh: BLE listens only (no interruption); exact AAP needs the WSL hand-over (confirmed first) -->
            <DockPanel Margin="2,8,2,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource LinkButton}" Content="Refresh battery" Command="{Binding RefreshBatteryCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="Refresh battery (BLE, no interruption)"
                            ToolTip="Listens for the AirPods' next BLE advertisement (±10 %). Bluetooth keeps working. BLE cannot force a new value." />
                    <Button Style="{StaticResource LinkButton}" Content="Exact (AAP)…" Command="{Binding ExactBatteryCommand}" Margin="10,0,0,0"
                            Visibility="{Binding ExactBatteryAvailable, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="Exact battery over the WSL bridge — interrupts Bluetooth"
                            ToolTip="1 % precision through the WSL bridge: Windows Bluetooth (audio, mouse, keyboard) is off for about 10 s. Asks first." />
                </StackPanel>
                <TextBlock Text="{Binding BatteryStatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Top" />
            </DockPanel>

            <!-- Noise control -->
            <TextBlock Text="Noise Control" Margin="2,18,0,8" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource LabelBrush}" />
            <UniformGrid Columns="3" Margin="-4,0">
                <c:ModeButton Caption="Cancellation" Glyph="{StaticResource GlyphAnc}" IsActive="{Binding IsAnc}" IsPending="{Binding PendingAnc}"
                              Command="{Binding SetModeCommand}" CommandParameter="{x:Static p:ListeningMode.NoiseCancellation}"
                              ToolTip="Active Noise Cancellation" />
                <c:ModeButton x:Name="offButton" Caption="Off" Glyph="{StaticResource GlyphOff}" IsActive="{Binding IsOff}" IsPending="{Binding PendingOff}"
                              Command="{Binding SetModeCommand}" CommandParameter="{x:Static p:ListeningMode.Off}"
                              ToolTip="Turns both ANC and Transparency off on the AirPods (not a mute)." />
                <c:ModeButton Caption="Transparency" Glyph="{StaticResource GlyphTransparency}" IsActive="{Binding IsTransparency}" IsPending="{Binding PendingTransparency}"
                              Command="{Binding SetModeCommand}" CommandParameter="{x:Static p:ListeningMode.Transparency}"
                              ToolTip="Transparency mode" />
            </UniformGrid>
            <c:ModeButton Caption="Adaptive" Glyph="{StaticResource GlyphAdaptive}" Height="62" Margin="0,8,0,0"
                          IsActive="{Binding IsAdaptive}" IsPending="{Binding PendingAdaptive}"
                          Command="{Binding SetModeCommand}" CommandParameter="{x:Static p:ListeningMode.Adaptive}"
                          Visibility="{Binding ShowAdaptive, Converter={StaticResource BoolVis}}" ToolTip="Adaptive Audio" />

            <!-- Error from last command -->
            <Border x:Name="errorBox" CornerRadius="10" Margin="0,12,0,0" Padding="12,8" Background="#26FF6B6B" BorderBrush="#55FF6B6B" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BadBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="350" />
                </StackPanel>
            </Border>

            <!-- Control channel status -->
            <Border CornerRadius="10" Margin="0,12,0,0" Padding="12,9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0DFFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChannelProblem}" Value="True">
                                <Setter Property="Background" Value="#1FFFC857" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ChannelText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" BorderThickness="0" Background="#22FFFFFF"
                                 Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsSwitching, Converter={StaticResource BoolVis}}" />
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding ChannelProblem, Converter={StaticResource BoolVis}}">
                        <Button Style="{StaticResource LinkButton}" Content="Set up driverless mode (WSL2)" Command="{Binding SetupCommand}" Margin="0,0,8,6"
                                FontWeight="SemiBold" Visibility="{Binding OfferBridgeSetup, Converter={StaticResource BoolVis}}"
                                ToolTip="No Test Mode, no Secure Boot change: commands go through a small Linux (WSL2) for a few seconds." />
                        <Button Style="{StaticResource LinkButton}" Content="Retry" Command="{Binding ReconnectCommand}" Margin="0,0,8,6" />
                        <Button Style="{StaticResource LinkButton}" Content="MagicAAP driver info" Click="Help_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
