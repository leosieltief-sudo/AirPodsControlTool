<UserControl x:Class="AirPodsControl.App.Controls.BatteryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="12,10,12,12"
            ToolTip="{Binding SourceHint}">
        <StackPanel>
            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource LabelBrush}"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                <TextBlock x:Name="bolt" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
                <TextBlock x:Name="pct" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <Grid Height="6">
                <Border CornerRadius="3" Background="#2AFFFFFF" />
                <Border x:Name="bar" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="barScale" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
