<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-specific Bluetooth plumbing: WinRT (radio, paired devices, BLE advertisements),
       CfgMgr32 (BTHENUM device tree), and the kernel-driver backed AAP L2CAP transport. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>AirPodsControl.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Driverless (WSL2) bridge assets, copied into the WSL distribution / run elevated by the setup wizard -->
    <EmbeddedResource Include="..\..\bridge\linux\aap_bridge.py" LogicalName="bridge/aap_bridge.py" />
    <EmbeddedResource Include="..\..\bridge\linux\aapd.py" LogicalName="bridge/aapd.py" />
    <EmbeddedResource Include="..\..\bridge\linux\bridge.sh" LogicalName="bridge/bridge.sh" />
    <EmbeddedResource Include="..\..\bridge\windows\elevated-setup.ps1" LogicalName="bridge/elevated-setup.ps1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AirPodsControl.Core\AirPodsControl.Core.csproj" />
  </ItemGroup>
</Project>
